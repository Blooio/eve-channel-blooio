{
  "name": "eve-channel-blooio",
  "version": "0.3.0",
  "description": "Blooio channel for Vercel eve. Send and receive iMessage, RCS, SMS, and Apple Messages for Business through the Blooio v4 API, with interactive messages (quick replies, list and time pickers, forms), tapback reactions, typing indicators, read receipts, polls, groups, capability checks, and history.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "David Harvey",
    "email": "david@blooio.com"
  },
  "homepage": "https://blooio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blooio/eve-channel-blooio.git"
  },
  "bugs": {
    "url": "https://github.com/Blooio/eve-channel-blooio/issues"
  },
  "keywords": [
    "eve",
    "vercel-eve",
    "eve-channel",
    "blooio",
    "imessage",
    "rcs",
    "sms",
    "apple-messages-for-business",
    "apple-business-chat",
    "amb",
    "agent",
    "ai-agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "release-it"
  },
  "peerDependencies": {
    "ai": ">=7.0.0",
    "eve": ">=0.43.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.137",
    "eve": "^0.76.0",
    "release-it": "^20.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^4.6.5"
  }
}
